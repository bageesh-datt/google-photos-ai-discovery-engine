# LLM Configuration (Groq, OpenAI, or Gemini)
# For Groq: Obtain your key starting with 'gsk_' from https://console.groq.com
# For Gemini: Obtain your key starting with 'AIzaSy' from Google AI Studio
# For OpenAI: Obtain your key starting with 'sk-' from OpenAI Platform
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=

# Storage & Application Configuration (Optional: auto-adapts for local / Vercel serverless)
DATA_DIR=data
OUTPUT_DIR=output
HOST=0.0.0.0
PORT=8000

